DEBUG=True
SECRET_KEY=django-insecure-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Pon USE_SQLITE=True para desarrollo sin MySQL (compañeros sin MySQL instalado)
USE_SQLITE=False

# MySQL local (solo si USE_SQLITE=False)
DB_NAME=financekids
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Email settings for recovery and login confirmation
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu-correo@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password
DEFAULT_FROM_EMAIL=no-reply@financekids.local

# Production hardening (set in production env only)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
