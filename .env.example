DEBUG=True
SECRET_KEY=django-insecure-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Pon USE_SQLITE=True para desarrollo sin MySQL (compañeros sin MySQL instalado)
USE_SQLITE=False

# MySQL local (solo si USE_SQLITE=False)
DB_NAME=financekids
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Email settings for recovery and login confirmation
# Usa variables de entorno; nunca subas credenciales reales.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=mailtrap-username
EMAIL_HOST_PASSWORD=mailtrap-password
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@financekids.local
PUBLIC_BASE_URL=http://127.0.0.1:8000
PASSWORD_RESET_TIMEOUT=3600

# Production hardening (set in production env only)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
