DEBUG=True
SECRET_KEY=django-insecure-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Pon USE_SQLITE=True para desarrollo sin MySQL (compañeros sin MySQL instalado)
USE_SQLITE=False

# MySQL local (solo si USE_SQLITE=False)
DB_NAME=financekids
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Production hardening (set in production env only)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
